{
	"name": "chess-now",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev:web": "next dev",
		"dev:api": "bun --hot --no-clear-screen src/api/index.ts",
		"dev": "concurrently \"bun dev:web\" \"bun dev:api\"",
		"email": "email dev --dir src/emails --port 3001",
		"start:web": "next start",
		"start:api": "bun src/api/index.ts",
		"build": "next build",
		"check": "bunx @biomejs/biome check --write",
		"client:discord": "bun packages/discord/src/index.ts",
		"auth:generate": "bunx auth@latest generate --output ./src/db/schema/auth-schema.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:push": "bunx drizzle-kit push"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.23",
		"@better-auth/drizzle-adapter": "^1.6.23",
		"@cacheable/node-cache": "^3.1.1",
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@keyv/redis": "^5.1.6",
		"@marsidev/react-turnstile": "1.5.3",
		"@types/mdx": "^2.0.14",
		"better-auth": "^1.6.23",
		"better-sqlite3": "^12.11.1",
		"chess.js": "^1.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"fumadocs-core": "^16.11.5",
		"fumadocs-mdx": "^15.2.0",
		"fumadocs-openapi": "^11.2.2",
		"fumadocs-typescript": "^5.3.0",
		"fumadocs-ui": "^16.11.5",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.25.0",
		"next": "16.2.10",
		"next-themes": "^0.4.6",
		"pg": "^8.22.0",
		"radix-ui": "^1.6.2",
		"react": "19.2.7",
		"react-chessboard": "^5.10.0",
		"react-dom": "19.2.7",
		"react-email": "^6.9.0",
		"resend": "^6.17.2",
		"shadcn": "^4.13.1",
		"shiki": "^4.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@react-email/ui": "6.9.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	}
}
