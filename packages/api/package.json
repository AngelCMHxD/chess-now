{
	"name": "@chess-now/api",
	"description": "The official API wrapper for Chess Now!",
	"license": "MIT",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "npm run build"
	},
	"author": "AngelCMHxD",
	"devDependencies": {
		"@types/bun": "latest",
		"tsup": "^8.5.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
